{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-record.json",
  "title": "Decision Record",
  "description": "Generic decision record for any system writing to the immutable ledger. Domain-agnostic — the ledger and auditors do not know what system produced this.",
  "type": "object",
  "required": ["system_id", "decisions"],
  "properties": {
    "system_id": {
      "type": "string",
      "description": "Identifier of the system that made the decision"
    },
    "batch_id": {
      "type": "string",
      "description": "Unique identifier for this batch of decisions"
    },
    "domain": {
      "type": "string",
      "description": "Domain context (e.g. kubernetes, finance, telecom)"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["subject_id", "subject_type", "severity", "outcome", "agent", "confidence"],
      "properties": {
        "subject_id": {
          "type": "string",
          "description": "Unique identifier of what was decided on"
        },
        "subject_type": {
          "type": "string",
          "description": "Type of the subject (e.g. signal_type, event_type)"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "outcome": {
          "type": "string",
          "enum": ["keep", "drop", "suppress", "dedupe", "escalate", "classify"],
          "description": "What was decided"
        },
        "agent": {
          "type": "string",
          "description": "Name of the agent/component that made the decision"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier": {
          "type": "string",
          "description": "Processing tier (e.g. nano, micro, macro)"
        },
        "namespace": {
          "type": "string",
          "description": "Grouping context"
        },
        "evidence": {
          "type": "string",
          "description": "Reason for the decision"
        }
      }
    }
  }
}
