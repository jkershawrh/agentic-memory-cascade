{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-verdict.json",
  "title": "Audit Verdict",
  "description": "Generic audit verdict from an independent auditor. Domain-agnostic — any auditor can produce this for any decision record.",
  "type": "object",
  "required": ["decision_ref", "subject_type", "original_outcome", "verdict"],
  "properties": {
    "decision_ref": {
      "type": "string",
      "description": "Reference to the original decision (subject_id from decision record)"
    },
    "subject_type": {
      "type": "string",
      "description": "Type of the subject that was decided on"
    },
    "original_outcome": {
      "type": "string",
      "enum": ["keep", "drop", "suppress", "dedupe", "escalate", "classify"]
    },
    "original_agent": {
      "type": "string",
      "description": "Agent that made the original decision"
    },
    "original_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "domain": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["SURVIVES", "FAILS"],
      "description": "SURVIVES = decision was correct, FAILS = decision was wrong (false negative)"
    },
    "checks_passed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Deterministic checks that passed"
    },
    "checks_failed": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Deterministic checks that failed"
    },
    "probe_result": {
      "type": ["string", "null"],
      "description": "LLM adversary probe result, if run"
    },
    "reason": {
      "type": "string",
      "description": "Human-readable explanation of the verdict"
    }
  }
}
