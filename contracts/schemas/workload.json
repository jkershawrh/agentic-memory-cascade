{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workload-profile",
  "title": "Workload Profile",
  "description": "FSI business process workload with signal distribution and model requirements",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "daily_volume",
    "signal_distribution",
    "tokens_per_signal",
    "latency_requirement_ms",
    "model_by_tier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "daily_volume": {
      "type": "integer",
      "minimum": 1
    },
    "signal_distribution": {
      "type": "object",
      "required": ["routine_pct", "ambiguous_pct", "complex_pct"],
      "properties": {
        "routine_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ambiguous_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "complex_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "tokens_per_signal": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "latency_requirement_ms": {
      "type": "integer",
      "minimum": 1
    },
    "model_by_tier": {
      "type": "object",
      "required": ["nano", "micro", "macro"],
      "properties": {
        "nano": {
          "type": ["string", "null"]
        },
        "micro": {
          "type": "string"
        },
        "macro": {
          "type": "string"
        }
      }
    }
  }
}
